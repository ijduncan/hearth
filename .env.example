# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
# Optional model overrides (defaults shown)
OPENAI_ACKNOWLEDGMENT_MODEL=gpt-5.6-luna
OPENAI_INSIGHTS_MODEL=gpt-5.6-terra
OPENAI_REPORT_MODEL=gpt-5.6-sol

# App
NEXT_PUBLIC_APP_NAME=Hearth
ALLOWED_EMAILS=alice@example.com,bob@example.com

# Browser Push (generate once with: npm run notifications:generate-keys)
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Scheduled jobs (use the same value in Vercel and Supabase Vault)
CRON_SECRET=
