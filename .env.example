# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown)
ANTHROPIC_REFLECTION_MODEL=claude-sonnet-4-6
ANTHROPIC_THERAPIST_MODEL=claude-opus-4-8

# App
NEXT_PUBLIC_APP_NAME=Hearth
ALLOWED_EMAILS=alice@example.com,bob@example.com

# Browser Push (generate once with: npm run notifications:generate-keys)
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Scheduled jobs (use the same value in Vercel and Supabase Vault)
CRON_SECRET=
